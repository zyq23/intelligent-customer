# ============================================================
# Large Model Files (GitHub blocks >100MB)
# ============================================================
# Microsoft GraphRAG downloaded models (multi-GB)
customer-service-platform/backend/app/graphrag/models/
# HuggingFace hub cache
customer-service-platform/backend/app/graphrag/models/*/*/snapshots/
customer-service-platform/backend/app/graphrag/models/*/*/blobs/

# ============================================================
# Generated Data & Cache (Regenerated at runtime)
# ============================================================
# GraphRAG generated indices and cache
customer-service-platform/backend/app/graphrag/data/output/
customer-service-platform/backend/app/graphrag/data/#Uf05clancedb
customer-service-platform/backend/app/graphrag/data/cache
customer-service-platform/backend/app/graphrag/data/update_output
customer-service-platform/backend/app/graphrag/text_logs/
customer-service-platform/backend/app/graphrag/text_cache/
customer-service-platform/backend/app/graphrag/pdf_outputs
customer-service-platform/backend/app/graphrag/*.json
customer-service-platform/backend/app/graphrag/data/prompt_turn_output
customer-service-platform/backend/app/graphrag/data/pdf_csv_exports

# ============================================================
# Uploads & Temporary Files
# ============================================================
customer-service-platform/uploads/
customer-service-platform/backend/uploads/
customer-service-platform/backend/app/graphrag/data/input/*/*_extracted.txt


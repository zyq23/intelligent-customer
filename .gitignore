# ============================================================
# Personal / Training / Non-project files (DO NOT COMMIT)
# ============================================================
# Training materials from 24级研究生 - remove entirely
customer-service-platform/24级研究生培养方案及学位答辩要求等相关文件/

# ZCode & Claude personal configuration
.zcode/
.claude/

# ============================================================
# Secrets & Environment Files (NEVER commit real credentials)
# ============================================================
# Backend environment with real API keys and passwords
customer-service-platform/backend/.env

# GraphRAG runtime config with real API keys
customer-service-platform/backend/app/graphrag/data/.env

# Example files are OK (templates)
!customer-service-platform/.env.example
!customer-service-platform/backend/.env.example
!customer-service-platform/backend/app/graphrag/data/settings.yaml.example


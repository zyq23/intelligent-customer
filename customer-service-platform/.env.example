# ============================================================
# 问道星辰智能客服系统 - 环境变量模板
# ============================================================
# 使用方法:
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际情况修改以下配置
# 3. 确保 backend/.env 也同步更新

# ---------- 大模型服务 (阿里云百炼 DashScope, OpenAI 兼容模式) ----------
# 需提供有效的 API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 视觉模型 (图片解析) ----------
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus

# ---------- Ollama 本地部署的模型 ----------
# 如需使用本地模型，请取消注释并配置
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_REASON_MODEL=deepseek-r1:7b
# OLLAMA_AGENT_MODEL=qwen2.5:7b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------- 模型服务选择 ----------
# 可选值：deepseek 或 ollama
CHAT_SERVICE=deepseek
REASON_SERVICE=deepseek
AGENT_SERVICE=deepseek

# ---------- 联网搜索 (SerpAPI, 可选但推荐) ----------
# 注册地址：https://serpapi.com/
# 未配置时，联网搜索功能将被禁用
SERPAPI_KEY=your_serpapi_key_here
SEARCH_RESULT_COUNT=3

# ---------- MySQL 数据库 ----------
DB_HOST=localhost
DB_PORT=3307
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=customer_service

# ---------- Neo4j 图数据库 ----------
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ---------- Redis 缓存 ----------
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_EXPIRE=3600
REDIS_CACHE_THRESHOLD=0.90

# ---------- JWT 认证 ----------
# ⚠️ 生产环境必须更改为随机字符串！
SECRET_KEY=your_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Embedding (词向量) ----------
EMBEDDING_TYPE=ollama  # 可选：ollama 或 sentence_transformer
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_THRESHOLD=0.90

# ---------- Microsoft GraphRAG ----------
# 相对于 backend 目录的路径
GRAPHRAG_PROJECT_DIR=/data/zyq/intelligent-customer/customer-service-platform/backend/app/graphrag
GRAPHRAG_DATA_DIR=data
GRAPHRAG_QUERY_TYPE=local  # 可选：local, global, drift, basic
GRAPHRAG_RESPONSE_TYPE=text
GRAPHRAG_COMMUNITY_LEVEL=3
GRAPHRAG_DYNAMIC_COMMUNITY=false
